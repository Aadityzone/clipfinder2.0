AI_SERVICE_SECRET=replace-with-a-random-secret
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
MEDIA_STORAGE_ROOT=./storage

# Model loading. Constructing WhisperModel may download the model on first use,
# which is the only network access during transcription. The load is bounded so a
# stalled or interrupted download cannot wedge the transcription route.
#   WHISPER_LOAD_TIMEOUT_SECONDS  max seconds to wait for the model to load (default 300)
#   WHISPER_LOCAL_FILES_ONLY      set to 1 to never download; fails fast with an
#                                 actionable message if the model is not cached.
#                                 Use this in offline deployments. A partially
#                                 downloaded model (for example a cached snapshot
#                                 missing model.bin) is reported immediately.
WHISPER_LOAD_TIMEOUT_SECONDS=300
WHISPER_LOCAL_FILES_ONLY=0

# Optional request-local transcript retrieval. Uses the existing sentence-
# transformers dependency and an already cached local model; it never downloads.
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_WORDS=110
RAG_CHUNK_OVERLAP_WORDS=20
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RETRIEVAL_LIMIT=3
RAG_CONTEXT_MAX_CHARS=600

# Optional LLM rescoring. If OPENAI_API_KEY is set, the cloud-compatible
# Responses API is used. Otherwise, configure Ollama for local inference.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional local inference (no cloud API key required).
# Start Ollama separately and pull a model that fits your hardware.
# Example: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
