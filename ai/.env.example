AI_SERVICE_SECRET=replace-with-a-random-secret
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
MEDIA_STORAGE_ROOT=./storage

# Optional LLM rescoring. If OPENAI_API_KEY is set, the cloud-compatible
# Responses API is used. Otherwise, configure Ollama for local inference.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional local inference (no cloud API key required).
# Start Ollama separately and pull a model that fits your hardware.
# Example: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
