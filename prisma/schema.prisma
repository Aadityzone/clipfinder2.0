generator client {
  provider = "prisma-client"
  output = "../web/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum ProjectMode { SHORTS LONG_FORM }
enum JobStatus { QUEUED DOWNLOADING INGESTING TRANSCRIBING ANALYZING EDITING RENDERING READY FAILED RETRYING CANCELLED }
enum SourceType { UPLOAD URL YOUTUBE TWITCH KICK GOOGLE_DRIVE }
enum ClipStatus { CANDIDATE SELECTED EDITING RENDERING READY FAILED REJECTED }
enum RenderStatus { QUEUED PROCESSING READY FAILED }
enum PublishStatus { DRAFT SCHEDULED PUBLISHING PUBLISHED FAILED CANCELLED }
enum FeedbackEvent { ACCEPT REJECT EDIT EXPORT PUBLISH }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
  jobs Job[]
  sources Source[]
  subscription Subscription?
  usage Usage?
  socialConnections SocialConnection[]
  scheduledPosts ScheduledPost[]
  analytics AnalyticsRecord[]
  favorites Favorite[]
  templates Template[]
  notifications Notification[]
  events CreatorEvent[]
}
model Subscription {
  id String @id @default(cuid())
  userId String @unique
  plan String @default("free")
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Usage {
  id String @id @default(cuid())
  userId String @unique
  minutesAnalyzed Float @default(0)
  renders Int @default(0)
  exports Int @default(0)
  periodStart DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Source {
  id String @id @default(cuid())
  userId String
  type SourceType
  url String?
  name String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  projects Project[]
  media MediaAsset[]
}
model MediaAsset {
  id String @id @default(cuid())
  sourceId String
  storageKey String
  mimeType String
  sizeBytes BigInt?
  durationS Float?
  width Int?
  height Int?
  fps Float?
  codec String?
  hasAudio Boolean @default(false)
  createdAt DateTime @default(now())
  source Source @relation(fields:[sourceId],references:[id],onDelete:Cascade)
  transcripts Transcript[]
  renders Render[]
}
model Project {
  id String @id @default(cuid())
  userId String
  sourceId String?
  name String
  mode ProjectMode @default(SHORTS)
  outputLanguage String @default("en")
  customInstructions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull)
  jobs Job[]
  analyses Analysis[]
  clips Clip[]
  favorites Favorite[]
  events CreatorEvent[]
}
model Job {
  id String @id @default(cuid())
  userId String
  projectId String?
  type String
  status JobStatus @default(QUEUED)
  progress Float @default(0)
  attempts Int @default(0)
  error String?
  payload Json?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
}
model Analysis {
  id String @id @default(cuid())
  projectId String
  model String
  version String
  status String @default("completed")
  metadata Json?
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  highlights Highlight[]
}
model Transcript {
  id String @id @default(cuid())
  mediaAssetId String
  language String
  text String
  metadata Json?
  createdAt DateTime @default(now())
  mediaAsset MediaAsset @relation(fields:[mediaAssetId],references:[id],onDelete:Cascade)
  segments TranscriptSegment[]
}
model TranscriptSegment {
  id String @id @default(cuid())
  transcriptId String
  startS Float
  endS Float
  text String
  confidence Float?
  transcript Transcript @relation(fields:[transcriptId],references:[id],onDelete:Cascade)
  words TranscriptWord[]
}
model TranscriptWord {
  id String @id @default(cuid())
  segmentId String
  startS Float
  endS Float
  word String
  confidence Float?
  segment TranscriptSegment @relation(fields:[segmentId],references:[id],onDelete:Cascade)
}
model Highlight {
  id String @id @default(cuid())
  analysisId String
  startS Float
  endS Float
  score Float
  category String
  rationale String?
  features Json?
  analysis Analysis @relation(fields:[analysisId],references:[id],onDelete:Cascade)
  clip Clip?
}
model Clip {
  id String @id @default(cuid())
  projectId String
  highlightId String? @unique
  title String?
  status ClipStatus @default(CANDIDATE)
  startS Float
  endS Float
  score Float?
  category String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  highlight Highlight? @relation(fields:[highlightId],references:[id],onDelete:SetNull)
  edit ClipEdit?
  captions CaptionTrack[]
  renders Render[]
  exports Export[]
  favorites Favorite[]
  scheduledPosts ScheduledPost[]
}
model ClipEdit {
  id String @id @default(cuid())
  clipId String @unique
  aspectRatio String @default("9:16")
  segments Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
  clip Clip @relation(fields:[clipId],references:[id],onDelete:Cascade)
}
model CaptionTrack {
  id String @id @default(cuid())
  clipId String
  language String
  style Json?
  cues Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clip Clip @relation(fields:[clipId],references:[id],onDelete:Cascade)
}
model Render {
  id String @id @default(cuid())
  clipId String
  mediaAssetId String?
  status RenderStatus @default(QUEUED)
  storageKey String?
  mimeType String?
  durationS Float?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clip Clip @relation(fields:[clipId],references:[id],onDelete:Cascade)
  mediaAsset MediaAsset? @relation(fields:[mediaAssetId],references:[id],onDelete:SetNull)
  exports Export[]
}
model Export {
  id String @id @default(cuid())
  clipId String
  renderId String?
  userId String
  storageKey String?
  status String @default("READY")
  createdAt DateTime @default(now())
  clip Clip @relation(fields:[clipId],references:[id],onDelete:Cascade)
  render Render? @relation(fields:[renderId],references:[id],onDelete:SetNull)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model SocialConnection {
  id String @id @default(cuid())
  userId String
  provider String
  accountId String
  accessToken String
  refreshToken String?
  expiresAt DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  posts ScheduledPost[]
  @@unique([userId,provider])
}
model ScheduledPost {
  id String @id @default(cuid())
  userId String
  socialConnectionId String?
  clipId String?
  scheduledFor DateTime
  status PublishStatus @default(SCHEDULED)
  platformPostId String?
  error String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  socialConnection SocialConnection? @relation(fields:[socialConnectionId],references:[id],onDelete:SetNull)
  clip Clip? @relation(fields:[clipId],references:[id],onDelete:SetNull)
}
model AnalyticsRecord {
  id String @id @default(cuid())
  userId String
  platform String
  postId String
  views Int @default(0)
  likes Int @default(0)
  comments Int @default(0)
  shares Int @default(0)
  watchTimeS Float @default(0)
  recordedAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Favorite {
  id String @id @default(cuid())
  userId String
  projectId String?
  clipId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
  clip Clip? @relation(fields:[clipId],references:[id],onDelete:Cascade)
}
model Template {
  id String @id @default(cuid())
  userId String
  name String
  settings Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model CreatorEvent {
  id String @id @default(cuid())
  userId String
  projectId String?
  event FeedbackEvent
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
}
